{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "expense-tracker-agent",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  // "vars": {
  //   "MY_VAR": "my-variable"
  // },
  // `CACHE` namespace (created via `wrangler kv namespace create CACHE`).
  // Local dev (`wrangler dev`) still simulates KV locally under this id.
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "c09d3be037d540689db87075bf695850",
    },
  ],
